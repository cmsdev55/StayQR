# Copy to .env.local for development. Locally only DATABASE_URL is needed (scripts/db-local.sh): emails print to the
# server log and checkout is simulated. Production needs every line marked (required).

NEXT_PUBLIC_SITE_URL=https://endureqr.com                 # (required) short links, email links, OAuth redirect

# Database: Railway → Postgres service → Variables → DATABASE_PUBLIC_URL (Vercel connects from outside Railway)
DATABASE_URL=                                          # (required)

# Email: resend.com → API Keys; verify the endureqr.com domain first
RESEND_API_KEY=                                        # (required)
EMAIL_FROM=EndureQR <hello@endureqr.com>

# Google sign-in (optional): Google Cloud → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URI: https://endureqr.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing: Polar → Settings → Developers (organisation access token) / Webhooks; product ids from each product
POLAR_ACCESS_TOKEN=                                    # (required)
POLAR_WEBHOOK_SECRET=                                  # (required) webhook URL: https://endureqr.com/api/webhooks/polar
POLAR_PRODUCT_PRO_MONTHLY=                             # (required)
POLAR_PRODUCT_PRO_YEARLY=                              # (required)
POLAR_PRODUCT_LIFETIME=                                # (required)
POLAR_SERVER=                                          # "sandbox" for a sandbox.polar.sh token; empty for live

CRON_SECRET=                                           # (required) Vercel sends it to /api/cron/retention
GOOGLE_SAFE_BROWSING_KEY=                              # optional: blocks known phishing/malware destinations

# Search engines: only the content="…" value of each verification meta tag (Google: comma-separate several properties)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Ads (see docs/ROADMAP.md)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
