# Copy to .env.local for development. Everything is optional locally: without Supabase you get a localhost-only
# dev login, and without Lemon Squeezy checkout is simulated. Production needs every line marked (required).

NEXT_PUBLIC_SITE_URL=https://stayqr.com                 # (required) used for short links and auth redirects

# Database: Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL=                                          # (required)

# Auth: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=                              # (required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=                         # (required)
SUPABASE_SERVICE_ROLE_KEY=                             # deletes the auth user when someone deletes their account
NEXT_PUBLIC_AUTH_GOOGLE=                               # set to 1 after enabling the Google provider in Supabase

# Billing: Lemon Squeezy → Settings → API / Webhooks; variant ids from each product's variant
LEMONSQUEEZY_API_KEY=                                  # (required)
LEMONSQUEEZY_STORE_ID=                                 # (required)
LEMONSQUEEZY_WEBHOOK_SECRET=                           # (required) webhook URL: https://stayqr.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=                      # (required)
LEMONSQUEEZY_VARIANT_PRO_YEARLY=                       # (required)
LEMONSQUEEZY_VARIANT_LIFETIME=                         # (required)

CRON_SECRET=                                           # (required) Vercel sends it to /api/cron/retention
GOOGLE_SAFE_BROWSING_KEY=                              # optional: blocks known phishing/malware destinations

# Ads (see docs/ROADMAP.md)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
