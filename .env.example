# Copy to .env.local for development. Locally only DATABASE_URL is needed (scripts/db-local.sh): emails print to the
# server log and checkout is simulated. Production needs every line marked (required).

NEXT_PUBLIC_SITE_URL=https://stayqr.com                 # (required) short links, email links, OAuth redirect

# Database: Railway → Postgres service → Variables → DATABASE_PUBLIC_URL (Vercel connects from outside Railway)
DATABASE_URL=                                          # (required)

# Email: resend.com → API Keys; verify the stayqr.com domain first
RESEND_API_KEY=                                        # (required)
EMAIL_FROM=StayQR <hello@stayqr.com>

# Google sign-in (optional): Google Cloud → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URI: https://stayqr.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing: Lemon Squeezy → Settings → API / Webhooks; variant ids from each product's variant
LEMONSQUEEZY_API_KEY=                                  # (required)
LEMONSQUEEZY_STORE_ID=                                 # (required)
LEMONSQUEEZY_WEBHOOK_SECRET=                           # (required) webhook URL: https://stayqr.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=                      # (required)
LEMONSQUEEZY_VARIANT_PRO_YEARLY=                       # (required)
LEMONSQUEEZY_VARIANT_LIFETIME=                         # (required)

CRON_SECRET=                                           # (required) Vercel sends it to /api/cron/retention
GOOGLE_SAFE_BROWSING_KEY=                              # optional: blocks known phishing/malware destinations

# Search engines: only the content="…" value of each verification meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Ads (see docs/ROADMAP.md)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
