{
  "regions": [
    "sfo1"
  ],
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.endureqr.com"
        }
      ],
      "destination": "https://endureqr.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.endureqr.com"
        }
      ],
      "destination": "https://endureqr.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "endureqr.vercel.app"
        }
      ],
      "destination": "https://endureqr.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "endureqr.vercel.app"
        }
      ],
      "destination": "https://endureqr.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "stayqr-six.vercel.app"
        }
      ],
      "destination": "https://endureqr.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "stayqr-six.vercel.app"
        }
      ],
      "destination": "https://endureqr.com/:path+",
      "permanent": true
    }
  ]
}
